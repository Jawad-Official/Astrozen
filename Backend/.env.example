# Backend environment variables
# Copy to Backend/.env and fill in. Never commit the filled-in .env.

# App
ENVIRONMENT=development
PROJECT_NAME=Astrozen API
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Auth
JWT_SECRET=replace-with-a-long-random-secret-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///astrozen.db

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI - Google AI Studio (Gemini), via its OpenAI-compatible endpoint.
# REQUIRED for every AI feature: idea clarification, validation, blueprints,
# and document generation. Without it those routes return 503.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Must be a model your key can actually reach - a rejected name fails every
# AI route with a 503 naming this variable. List what your key can see with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
MODEL_NAME=models/gemini-3.6-flash

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
